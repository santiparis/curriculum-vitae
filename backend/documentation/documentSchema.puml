@startuml
title Curriculum Vitae API - MongoDB Document Schema

skinparam classAttributeIconSize 0
skinparam shadowing false

package "MongoDB database: cv" {
    class "educationmodels" as Education <<collection>> {
        _id: ObjectId
        __v: Number
        id: Number (required)
        title: String (required)
        description: String (required)
        institution: String (required)
        startDate: String (required)
        endDate: String (optional)
        degree: String (required)
        skills: Skill[] (required, default: [])
    }

    class "experiencemodels" as Experience <<collection>> {
        _id: ObjectId
        __v: Number
        id: Number (required)
        entity: String (required)
        position: String (required)
        description: String (required)
        startDate: String (required)
        endDate: String (optional)
        skills: Skill[] (required, default: [])
    }

    class "projectmodels" as Project <<collection>> {
        _id: ObjectId
        __v: Number
        id: Number (required)
        title: String (required)
        description: String (required)
        link: String (required)
        status: String (required)
        skills: Skill[] (required, default: [])
    }
}

class Skill <<embedded subdocument; _id disabled>> {
    title: String (required)
    description: String (required)
    area: String (required)
}

Education "1" *-- "0..*" Skill : skills[]
Experience "1" *-- "0..*" Skill : skills[]
Project "1" *-- "0..*" Skill : skills[]

note bottom
  Collection names are the defaults generated by Mongoose
  from the registered model names.
  Date values are stored as strings (YYYY-MM-DD).
end note
@enduml